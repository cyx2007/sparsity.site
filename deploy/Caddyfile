{
	admin off
}

{$SITE_ORIGIN} {
	encode zstd gzip
	request_body {
		max_size 6MB
	}
	@health path /healthz
	respond @health 404
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy app:3000 {
		header_up -oai-*
	}
}
